{
  "manifest_version": 3,
  "name": "WordGlide",
  "version": "0.5.0",
  "description": "Find your reading rhythm. A gentle word-by-word guide for articles and GitHub READMEs.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WordGlide",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "activate": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Activate WordGlide on the current page"
    }
  },
  "background": { "service_worker": "background.js" }
}
